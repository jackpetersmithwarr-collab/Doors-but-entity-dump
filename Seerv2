---====== Setup Static Position & Door Hook ======---
entity:SetCallback("OnSpawned", function()
    print("Calculating real room center...")
    
    local latestRoomNum = ReplicatedStorage.GameData.LatestRoom.Value
    local MainRemote = ReplicatedStorage:FindFirstChild("MainRemote", true)
    
    local positionThread = task.spawn(function()
        local currentRoom = nil
        local targetCFrame = nil
        
        while not targetCFrame do
            currentRoom = Workspace.CurrentRooms:FindFirstChild(tostring(latestRoomNum))
            if currentRoom then
                local nodes = currentRoom:FindFirstChild("Nodes") or currentRoom:FindFirstChild("Pathfind")
                local middleNode = nil
                
                if nodes then
                    local children = nodes:GetChildren()
                    if #children > 0 then
                        middleNode = children[math.ceil(#children / 2)]
                    end
                end
                
                if middleNode and middleNode:IsA("BasePart") then
                    targetCFrame = middleNode.CFrame * CFrame.new(0, entity.Config.Entity.HeightOffset, 0)
                else
                    local entrance = currentRoom:FindFirstChild("RoomStart") or currentRoom:FindFirstChild("Base") or currentRoom.PrimaryPart
                    if entrance then
                        targetCFrame = entrance.CFrame * CFrame.new(0, entity.Config.Entity.HeightOffset, -30)
                    else
                        targetCFrame = currentRoom:GetPivot() * CFrame.new(0, entity.Config.Entity.HeightOffset, -30)
                    end
                end
            end
            if not targetCFrame then
                task.wait()
            end
        end
        
        print("Real middle locked! Freezing entity and starting custom look-check...")

        -- Keep pinning the entity to the true middle and check for looking manually
        while true do
            local entityModel = entity.Model or entity.Instance
            if entityModel then
                -- Keep locked in center
                for _, part in ipairs(entityModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.Anchored = true
                    end
                end
                entityModel:PivotTo(targetCFrame)
                
                -- Custom Camera Check (Dot Product)
                local camera = Workspace.CurrentCamera
                if camera then
                    -- Vector from camera position to entity position
                    local toEntity = (targetCFrame.Position - camera.CFrame.Position).Unit
                    -- Camera looking direction
                    local camDirection = camera.CFrame.LookVector
                    -- Dot product shows how closely they align (1 = perfectly looking at it, 0.8 = on screen)
                    local dotProduct = camDirection:Dot(toEntity)
                    
                    if dotProduct > 0.85 then 
                        -- Player is looking at the center spot! Apply damage via DOORS remote or fallback
                        local character = LocalPlayer.Character
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        
                        if humanoid and humanoid.Health > 0 then
                            if MainRemote then
                                MainRemote:FireServer("Damage", 8)
                            else
                                humanoid:TakeDamage(6)
                            end
                        end
                    end
                end
            end
            task.wait(0.8) -- UPDATED: Fires the damage tick exactly every 0.8 seconds
        end
    end)
    
    -- Watch for the next door opening to clean everything up
    local doorConnection
    doorConnection = ReplicatedStorage.GameData.LatestRoom.Changed:Connect(function(newRoomValue)
        if newRoomValue > latestRoomNum then
            print("Next door opened! Despawning entity...")
            task.cancel(positionThread)
            if doorConnection then
                doorConnection:Disconnect()
            end
            entity:Despawn()
        end
    end)
end)

-- Bypassing the built-in library callbacks since we hardcoded the look mechanics directly into our thread
